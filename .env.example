# Получите токен у @BotFather. Не публикуйте .env.
BOT_TOKEN=
# Числовые Telegram ID администраторов через запятую; узнать свой ID: /id
ADMIN_IDS=123456789
# Публичный username магазина без @. Меняется и в админке.
SHOP_USERNAME=
# Необязательно: ID чата/группы для уведомлений. Бот должен иметь право писать туда.
# Если пусто — уведомления получают администраторы после /start.
# ID закрытой группы: команда /chatid в ней от администратора магазина.
# После изменения перезапустите бота и нажмите «Проверить уведомления» в настройках.
NOTIFY_CHAT_ID=
# Для Mini App нужен публичный HTTPS-адрес. Без него работает меню Telegram.
WEBAPP_URL=
# Для запуска compose.server.yaml: домен без https:// (DNS должен указывать на сервер).
SHOP_DOMAIN=
# Username бота определяется автоматически через Telegram при запуске.
BOT_USERNAME=
# Доверенные прокси. Без прокси оставьте пустым; серверный Compose задаёт сам.
TRUSTED_PROXY_IPS=
HOST=127.0.0.1
PORT=8080
DB_PATH=data/konspektum.sqlite3
